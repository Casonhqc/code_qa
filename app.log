class AuthService:
    def __init__(self, user_db):
        self.user_db = user_db

    def login(self, username, password, verify_code=None, session=None):
        if not verify_code or not self.verify_captcha(session, verify_code):
            raise Exception("Invalid or missing verification code")
        
        user = self.user_db.get_user(username)
        if user and user.verify_password(password):
            session['loginUser'] = user.nickname
            session['loginUserId'] = user.id
            return self.generate_token(user)
        else:
            raise Exception("Invalid username or password")

    def verify_captcha(self, session, verify_code):
        # Assuming the code to check verification from session
        captcha_code = session.get('captcha_code')
        return captcha_code == verify_code

    def generate_token(self, user):
        import jwt
        token = jwt.encode({"user_id": user.id}, 'secret', algorithm='HS256')
        return token
```'
