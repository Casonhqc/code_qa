19-Jun-25 19:41:31 - ```python
class FlashSale:
    def __init__(self, product, quantity):
        self.product = product
        self.quantity = quantity
        self.sold_out = False

    def purchase(self, amount):
        if self.sold_out:
            return "Sold out"
        if amount > self.quantity:
            return "Not enough stock"
        
        self.quantity -= amount
        if self.quantity <= 0:
            self.sold_out = True
            return "Purchase completed, item sold out"
        return "Purchase completed, items remaining: {}".format(self.quantity)

    def restock(self, amount):
        if amount <= 0:
            return "Restock amount must be positive"
        self.quantity += amount
        self.sold_out = False
        return "Restocked, current quantity: {}".format(self.quantity)

# Example usage
flash_sale = FlashSale(product="Smartphone", quantity=100)
print(flash_sale.purchase(10))  # Purchase 10 items
print(flash_sale.purchase(95))  # Try to purchase 95 items
print(flash_sale.purchase(5))   # Attempt to purchase more after being sold out
print(flash_sale.restock(50))    # Restock with 50 more items
print(flash_sale.purchase(45))   # Purchase 45 items after restock
```
